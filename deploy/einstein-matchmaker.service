[Unit]
Description=EINSTEIN Matchmaker web UI (JigJoy hackathon), VPN-only via nginx
After=network-online.target

[Service]
WorkingDirectory=/root/hackathon/3alet-2026
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8791
# Live searches call paid OpenAI APIs. Hard caps per search and in total (ledger: runs/search-ledger.json).
Environment=ALLOW_LIVE_SEARCH=1
Environment=TRUST_ACCESS_HEADER=1
Environment=SEARCH_BUDGET_USD=0.10
Environment=SEARCH_TOTAL_BUDGET_USD=0.30
ExecStart=/usr/bin/env node --import tsx src/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
